# PostgreSQL — Supabase, Neon, or local. Pooled URL for the app:
# For high concurrency (bursts of logins), use your provider's POOLED
# connection string here (Neon: "-pooler" host, Supabase: port 6543).
# You can also cap Prisma's pool per instance: append ?connection_limit=10
DATABASE_URL="postgresql://user:password@localhost:5432/leetcode_hub"
# Direct (non-pooled) URL for migrations when using Supabase/Neon:
DIRECT_URL="postgresql://user:password@localhost:5432/leetcode_hub"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Encrypts TOTP secrets at rest. Keep separate from AUTH_SECRET so that
# rotating AUTH_SECRET does not lock every 2FA user out.
ENCRYPTION_KEY="replace-me-too"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional — email/password works without them)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Seed admin account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# Data source
DATA_REPO="snehasishroy/leetcode-companywise-interview-questions"
DATA_BRANCH="master"
